<Window x:Class="EventManagement.Windows.RateParticipantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оценка участников" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <Border Grid.Row="0" 
                Style="{StaticResource EventCardStyle}"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Оценка участников активности" 
                          Style="{StaticResource HeaderTextStyle}"
                          Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Активность:"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"
                              Grid.Column="0"/>
                    <TextBlock Text="{Binding Activity.Название}"
                              Style="{StaticResource NormalTextStyle}"
                              Grid.Column="1"
                              Margin="5,0,0,0"/>

                    <TextBlock Text="Мероприятие:"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"
                              Grid.Column="2"
                              Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding Activity.Мероприятия.Название}"
                              Style="{StaticResource NormalTextStyle}"
                              Grid.Column="3"
                              Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список участников с оценками -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ParticipantsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EventCardStyle}" 
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Номер участника -->
                                <TextBlock Text="{Binding ParticipantNumber}"
                                          Style="{StaticResource NormalTextStyle}"
                                          FontWeight="Bold"
                                          FontSize="16"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Margin="0,0,15,0"/>

                                <!-- Информация об участнике -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Participant.Пользователи.ФИО}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="14"/>
                                    <TextBlock Text="{Binding Participant.Пользователи.Почта}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="12"
                                              Foreground="Gray"
                                              Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Оценка -->
                                <StackPanel Grid.Column="2" 
                                           Orientation="Horizontal"
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Оценка:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,0,5,0"/>
                                    <ComboBox x:Name="RatingComboBox"
                                             SelectedIndex="{Binding Rating}"
                                             Width="60">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="7"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                        <ComboBoxItem Content="10"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Комментарий -->
                                <StackPanel Grid.Column="3" 
                                           Margin="0,0,10,0">
                                    <TextBlock Text="Комментарий:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="12"/>
                                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource PrimaryTextBoxStyle}"
                                            Height="60"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Индикатор сохранения -->
                                <Border Grid.Column="4"
                                        Style="{StaticResource EventCardStyle}"
                                        Background="{StaticResource SecondaryBackgroundBrush}"
                                        Padding="5"
                                        Visibility="{Binding IsSaved, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓"
                                                  Foreground="Green"
                                                  FontWeight="Bold"
                                                  FontSize="14"/>
                                        <TextBlock Text="Сохранено"
                                                  Style="{StaticResource NormalTextStyle}"
                                                  Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Статистика и кнопки -->
        <Border Grid.Row="2" 
                Style="{StaticResource EventCardStyle}"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Статистика -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatisticsText}"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastSavedText}"
                              Style="{StaticResource HintTextStyle}"
                              FontSize="11"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal">
                    <Button x:Name="SaveAllButton"
                            Content="Сохранить все"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="15,8"
                            Margin="0,0,10,0"
                            Click="SaveAllButton_Click"/>

                    <Button x:Name="CancelButton"
                            Content="Закрыть"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="15,8"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>