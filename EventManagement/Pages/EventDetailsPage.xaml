<Page x:Class="EventManagement.Pages.EventDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Детали мероприятия">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Заголовок и кнопки действий -->
                <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Заголовок мероприятия -->
                        <TextBlock Text="{Binding Название}" 
                                  Style="{StaticResource HeaderTextStyle}"
                                  Grid.Column="0"/>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal"
                                   x:Name="ActionButtonsPanel">
                            <Button x:Name="EditEventButton"
                                    Content="Редактировать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="EditEventButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="CalculateWinnerButton"
                                    Content="Подсчитать победителя"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="CalculateWinnerButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="DeleteEventButton"
                                    Content="Удалить"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="#FFD32F2F"
                                    Margin="10,0,0,0"
                                    Click="DeleteEventButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="JoinEventButton"
                                    Content="Участвовать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="JoinEventButton_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Изображение мероприятия -->
                <Border Style="{StaticResource EventCardStyle}"
                        Height="300"
                        Margin="0,0,0,20">
                    <Image x:Name="EventImage"
                           Stretch="Uniform"/>
                </Border>

                <!-- Основная информация в вертикальном расположении -->
                <StackPanel>
                    <!-- Детали мероприятия -->
                    <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Детали мероприятия" 
                                      Style="{StaticResource SubHeaderTextStyle}"
                                      Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левый столбец - названия полей -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Дата начала:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"/>
                                    <TextBlock Text="Длительность:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Город:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Направление:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Организатор:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Победитель:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Правый столбец - значения полей -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ДатаНачала, StringFormat='dd.MM.yyyy'}"
                                              Style="{StaticResource NormalTextStyle}"/>
                                    <TextBlock Text="{Binding ДлительностьДней, StringFormat='\{0\} дней'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Города.Название}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Направления.Название}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Пользователи.ФИО}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Пользователи1.ФИО, FallbackValue='Не определен'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Описание мероприятия -->
                    <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Описание" 
                                      Style="{StaticResource SubHeaderTextStyle}"
                                      Margin="0,0,0,10"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <TextBlock Text="{Binding Описание}"
                                          Style="{StaticResource NormalTextStyle}"
                                          TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Активности -->
                    <Border Style="{StaticResource EventCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Активности" 
                                          Style="{StaticResource SubHeaderTextStyle}"
                                          Grid.Column="0"/>

                                <Button x:Name="AddActivityButton"
                                        Grid.Column="1"
                                        Content="+ Добавить активность"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddActivityButton_Click"
                                        Visibility="Collapsed"/>
                            </Grid>

                            <!-- Список активностей -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                         MaxHeight="400"
                                         Margin="0,10,0,0">
                                <ItemsControl x:Name="ActivitiesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EventCardStyle}" 
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Информация об активности -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Название}"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontWeight="Bold"
                                                                  TextWrapping="Wrap"/>

                                                        <StackPanel Orientation="Horizontal" 
                                                                   Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding День, StringFormat='День \{0\}'}"
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text=" • " 
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <!-- Исправленный формат времени -->
                                                            <TextBlock Text="{Binding ВремяНачала, StringFormat=hh\\:mm}"
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text=" • " 
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text="90 мин."
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Пользователи.ФИО, StringFormat='Модератор: \{0\}'}"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontSize="12"
                                                                  Margin="0,5,0,0"
                                                                  TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Кнопка удаления активности (только для организатора) -->
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="5"
                                                            Width="25"
                                                            Height="25"
                                                            Visibility="Collapsed"
                                                            Click="DeleteActivityButton_Click"
                                                            Tag="{Binding Id}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoActivitiesText"
                                      Text="Активности не добавлены"
                                      Style="{StaticResource HintTextStyle}"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>