<Page x:Class="EventManagement.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мероприятия"
      Loaded="Page_Loaded">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтров -->
        <Border Grid.Row="0" 
                Style="{StaticResource EventCardStyle}"
                Margin="10"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Поиск и фильтрация" 
                          Style="{StaticResource SubHeaderTextStyle}"
                          Margin="0,0,0,10"/>

                <!-- Строка поиска -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" 
                            Style="{StaticResource PrimaryTextBoxStyle}"
                            Margin="0,0,10,0"
                            TextChanged="SearchTextBox_TextChanged"
                            Padding="10"/>

                    <Button x:Name="SearchButton"
                            Grid.Column="1"
                            Content="Поиск"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="15,5"
                            Click="SearchButton_Click"/>
                </Grid>

                <!-- Фильтры -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <!-- Фильтр по направлению -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Направление:" 
                                  Style="{StaticResource NormalTextStyle}"
                                  Margin="0,0,0,5"/>
                        <ComboBox x:Name="DirectionComboBox"
                                 Style="{StaticResource PrimaryComboBoxStyle}"
                                 Width="200"
                                 SelectionChanged="DirectionComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Фильтр по дате -->
                    <StackPanel>
                        <TextBlock Text="Дата начала:" 
                                  Style="{StaticResource NormalTextStyle}"
                                  Margin="0,0,0,5"/>
                        <DatePicker x:Name="DateFilterPicker"
                                   Style="{StaticResource PrimaryDatePickerStyle}"
                                   Width="200"
                                   SelectedDateChanged="DateFilterPicker_SelectedDateChanged"/>
                    </StackPanel>

                    <!-- Кнопка сброса фильтров -->
                    <Button x:Name="ResetFiltersButton"
                            Content="Сбросить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="20,25,0,0"
                            Padding="10,5"
                            Click="ResetFiltersButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель действий для организатора -->
        <Border Grid.Row="1" 
                Style="{StaticResource EventCardStyle}"
                Margin="10,0,10,10"
                Padding="10"
                x:Name="OrganizerPanel"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddEventButton"
                        Content="+ Добавить мероприятие"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="15,8"
                        Click="AddEventButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Список мероприятий -->
        <ScrollViewer Grid.Row="2" 
                     VerticalScrollBarVisibility="Auto"
                     Margin="10,0,10,10">
            <ItemsControl x:Name="EventsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EventCardStyle}"
                                Width="350"
                                Height="250"
                                Margin="5"
                                Cursor="Hand"
                                MouseDown="EventCard_MouseDown"
                                Tag="{Binding Id}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок мероприятия -->
                                <TextBlock Grid.Row="0"
                                          Text="{Binding Название}"
                                          Style="{StaticResource SubHeaderTextStyle}"
                                          TextWrapping="Wrap"
                                          TextAlignment="Center"
                                          Margin="0,0,0,10"/>

                                <!-- Контент мероприятия -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левый блок с изображением и основной информацией -->
                                    <StackPanel Grid.Column="0" 
                                               Margin="0,0,10,0">
                                        <!-- Изображение мероприятия -->
                                        <Border Height="100" 
                                                Background="{StaticResource SecondaryBackgroundBrush}"
                                                CornerRadius="5"
                                                Margin="0,0,0,10">
                                            <Image x:Name="EventImage"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Основная информация -->
                                        <StackPanel>
                                            <TextBlock Text="{Binding ДатаНачала, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                                      Style="{StaticResource NormalTextStyle}"
                                                      FontSize="12"/>

                                            <TextBlock Text="{Binding Города.Название, StringFormat='Город: {0}'}"
                                                      Style="{StaticResource NormalTextStyle}"
                                                      FontSize="12"/>

                                            <TextBlock Text="{Binding Пользователи.ФИО, StringFormat='Организатор: {0}'}"
                                                      Style="{StaticResource NormalTextStyle}"
                                                      FontSize="12"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Правый блок с описанием -->
                                    <ScrollViewer Grid.Column="1" 
                                                 VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Описание}"
                                                  Style="{StaticResource NormalTextStyle}"
                                                  FontSize="12"
                                                  TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>