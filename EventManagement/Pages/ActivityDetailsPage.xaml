<Page x:Class="EventManagement.Pages.ActivityDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Детали активности">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Заголовок и кнопки действий -->
                <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Заголовок активности -->
                        <TextBlock Text="{Binding Название}" 
                                  Style="{StaticResource HeaderTextStyle}"
                                  Grid.Column="0"/>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal"
                                   x:Name="ActionButtonsPanel">
                            <Button x:Name="EditActivityButton"
                                    Content="Редактировать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="EditActivityButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="DeleteActivityButton"
                                    Content="Удалить"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Background="#FFD32F2F"
                                    Margin="10,0,0,0"
                                    Click="DeleteActivityButton_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Основная информация -->
                <StackPanel>
                    <!-- Детали активности -->
                    <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Детали активности" 
                                      Style="{StaticResource SubHeaderTextStyle}"
                                      Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левый столбец - названия полей -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Мероприятие:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"/>
                                    <TextBlock Text="День:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Время начала:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Продолжительность:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="Модератор:" 
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Правый столбец - значения полей -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Мероприятия.Название}"
                                              Style="{StaticResource NormalTextStyle}"/>
                                    <TextBlock Text="{Binding День, StringFormat='День \{0\}'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding ВремяНачала, StringFormat='hh\\:mm'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="90 минут"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Пользователи.ФИО}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Жюри -->
                    <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Жюри" 
                                          Style="{StaticResource SubHeaderTextStyle}"
                                          Grid.Column="0"/>

                                <Button x:Name="AddJuryButton"
                                        Grid.Column="1"
                                        Content="+ Добавить жюри"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddJuryButton_Click"
                                        Visibility="Collapsed"/>
                            </Grid>

                            <!-- Список жюри -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                         MaxHeight="200"
                                         Margin="0,10,0,0">
                                <ItemsControl x:Name="JuryItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EventCardStyle}" 
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Пользователи.ФИО}"
                                                              Style="{StaticResource NormalTextStyle}"
                                                              FontWeight="Bold"
                                                              TextWrapping="Wrap"/>

                                                    <!-- Кнопка удаления жюри (только для организатора) -->
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="5"
                                                            Width="25"
                                                            Height="25"
                                                            Visibility="Collapsed"
                                                            Click="DeleteJuryButton_Click"
                                                            Tag="{Binding Id}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoJuryText"
                                      Text="Жюри не назначены"
                                      Style="{StaticResource HintTextStyle}"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Участники -->
                    <Border Style="{StaticResource EventCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Участники" 
                                      Style="{StaticResource SubHeaderTextStyle}"
                                      Margin="0,0,0,10"/>

                            <!-- Список участников -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                         MaxHeight="300"
                                         Margin="0,10,0,0">
                                <ItemsControl x:Name="ParticipantsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EventCardStyle}" 
                                                    Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Пользователи.ФИО}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoParticipantsText"
                                      Text="Участники не зарегистрированы"
                                      Style="{StaticResource HintTextStyle}"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>