<Window x:Class="EventManagement.Windows.CalculateWinnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подсчет победителя мероприятия" 
        MinHeight="600" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <Border Grid.Row="0" 
                Style="{StaticResource EventCardStyle}"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Результаты участников мероприятия" 
                          Style="{StaticResource HeaderTextStyle}"
                          Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Мероприятие:"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"
                              Grid.Column="0"/>
                    <TextBlock Text="{Binding Event.Название}"
                              Style="{StaticResource NormalTextStyle}"
                              Grid.Column="1"
                              Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список участников с результатами -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ParticipantsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EventCardStyle}" 
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Место -->
                                <TextBlock Text="{Binding Rank}"
                                          Style="{StaticResource NormalTextStyle}"
                                          FontWeight="Bold"
                                          FontSize="16"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          Margin="0,0,15,0"/>

                                <!-- Информация об участнике -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding UserName}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="14"/>
                                    <TextBlock Text="Участник"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="12"
                                              Foreground="Gray"
                                              Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Количество активностей -->
                                <StackPanel Grid.Column="2" 
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Активности:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="12"/>
                                    <TextBlock Text="{Binding ActivitiesCount}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="14"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Количество оценок -->
                                <StackPanel Grid.Column="3" 
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Оценки:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="12"/>
                                    <TextBlock Text="{Binding EvaluationsCount}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="14"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Общий балл -->
                                <StackPanel Grid.Column="4" 
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Всего баллов:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="12"/>
                                    <TextBlock Text="{Binding TotalScore}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="14"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Средний балл -->
                                <StackPanel Grid.Column="5" 
                                           VerticalAlignment="Center">
                                    <TextBlock Text="Средний балл:"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontWeight="Bold"
                                              FontSize="12"/>
                                    <TextBlock Text="{Binding AverageScore, StringFormat='{}{0:F2}'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              FontSize="14"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Выбор победителя и кнопки -->
        <Border Grid.Row="2" 
                Style="{StaticResource EventCardStyle}"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Выбор победителя -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Выберите победителя:"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"
                              Margin="0,0,0,5"/>
                    <ComboBox x:Name="WinnerComboBox"
                             DisplayMemberPath="UserName"
                             SelectedValuePath="UserId"
                             Style="{StaticResource PrimaryComboBoxStyle}"
                             Width="300"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal">
                    <Button x:Name="SelectWinnerButton"
                            Content="Назначить победителем"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="15,8"
                            Margin="0,0,10,0"
                            Click="SelectWinnerButton_Click"/>

                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="15,8"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>