<Page x:Class="EventManagement.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" 
                Style="{StaticResource EventCardStyle}"
                Padding="40"
                Margin="20"
                Width="450"
                HorizontalAlignment="Center">

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Вход в систему" 
                          Style="{StaticResource HeaderTextStyle}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <!-- Поле почты/логина -->
                <Label Content="Электронная почта:" 
                       Style="{StaticResource PrimaryLabelStyle}"/>
                <TextBox x:Name="EmailTextBox" 
                        Style="{StaticResource PrimaryTextBoxStyle}"
                        Height="40"
                        TextChanged="EmailTextBox_TextChanged"
                        KeyDown="EmailTextBox_KeyDown"/>

                <!-- Поле пароля -->
                <Label Content="Пароль:" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,15,0,0"/>
                <PasswordBox x:Name="PasswordBox" 
                            Height="40"
                            FontFamily="{StaticResource MainFontFamily}"
                            FontSize="14"
                            BorderBrush="#FFCCCCCC"
                            BorderThickness="1"
                            Padding="8"
                            Margin="5"
                            PasswordChanged="PasswordBox_PasswordChanged"
                            KeyDown="PasswordBox_KeyDown"/>

                <!-- Кнопка входа -->
                <Button x:Name="LoginButton" 
                        Content="Войти" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="45"
                        Margin="0,30,0,15"
                        Click="LoginButton_Click"/>

                <!-- Разделитель -->
                <Separator Style="{StaticResource SeparatorStyle}"
                          Margin="0,10"/>

                <!-- Кнопка входа как гостя -->
                <Button x:Name="GuestButton" 
                        Content="Продолжить как гость" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="45"
                        Click="GuestButton_Click"/>

                <!-- Информационный текст -->
                <TextBlock Text="Для входа используйте зарегистрированную почту и пароль. Или продолжите как гость для просмотра мероприятий."
                          Style="{StaticResource HintTextStyle}"
                          TextWrapping="Wrap"
                          Margin="0,20,0,0"
                          TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>