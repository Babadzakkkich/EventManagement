<Window x:Class="EventManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MainWindowStyle}"
        Height="700" 
        Width="1000"
        Icon="Images/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header с информацией о пользователе -->
        <Border Grid.Row="0" 
                Background="{StaticResource AccentBrush}" 
                Padding="15"
                BorderBrush="LightGray"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Навигация -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <Button x:Name="EventsNavButton"
                            Content="Мероприятия"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="White"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="10,5"
                            Click="EventsNavButton_Click"/>

                    <Button x:Name="ActivitiesNavButton"
                            Content="Активности"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="White"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="10,5"
                            Margin="10,0,0,0"
                            Click="ActivitiesNavButton_Click"/>
                </StackPanel>

                <!-- Кнопка "Назад" -->
                <Button Grid.Column="1" 
                        x:Name="BackButton"
                        Content="← Назад" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="White"
                        Foreground="{StaticResource AccentBrush}"
                        Padding="10,5"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Click="BackButton_Click"
                        Visibility="Collapsed"/>

                <!-- Блок с информацией о пользователе -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           x:Name="UserInfoPanel"
                           Visibility="Collapsed">

                    <!-- Аватарка пользователя -->
                    <Button x:Name="AvatarButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="2"
                            BorderThickness="0"
                            Background="Transparent"
                            Click="AvatarButton_Click"
                            Cursor="Hand"
                            ToolTip="Мой профиль">
                        <Image x:Name="AvatarImage" 
                               Width="35" 
                               Height="35"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry RadiusX="17.5" RadiusY="17.5" Center="17.5,17.5"/>
                            </Image.Clip>
                        </Image>
                    </Button>

                    <!-- Информация о пользователе -->
                    <StackPanel Orientation="Vertical" 
                               Margin="10,0,15,0"
                               VerticalAlignment="Center">
                        <TextBlock x:Name="UsernameTextBlock" 
                                  FontWeight="Bold"
                                  FontSize="14"
                                  Foreground="White"/>
                        <TextBlock x:Name="RoleTextBlock" 
                                  FontSize="12"
                                  Foreground="#E0E0E0"/>
                    </StackPanel>

                    <!-- Кнопка "Выйти" -->
                    <Button x:Name="LogoutButton"
                            Content="Выйти"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="White"
                            Foreground="{StaticResource AccentBrush}"
                            Padding="10,5"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент - Frame для страниц -->
        <Frame Grid.Row="1" 
               x:Name="MainFrame" 
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>