<Window x:Class="EventManagement.Windows.AddEditEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="{Binding WindowTitle}" 
                  Style="{StaticResource HeaderTextStyle}"
                  Grid.Row="0"/>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Название мероприятия -->
                <Label Content="Название мероприятия:" 
                       Style="{StaticResource PrimaryLabelStyle}"/>
                <TextBox x:Name="TitleTextBox" 
                        Text="{Binding CurrentEvent.Название, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PrimaryTextBoxStyle}"/>

                <!-- Описание -->
                <Label Content="Описание:" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <TextBox x:Name="DescriptionTextBox" 
                        Text="{Binding CurrentEvent.Описание, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PrimaryTextBoxStyle}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="100"
                        VerticalScrollBarVisibility="Auto"/>

                <!-- Дата начала -->
                <Label Content="Дата начала:" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <DatePicker x:Name="StartDatePicker"
                           SelectedDate="{Binding CurrentEvent.ДатаНачала}"
                           Style="{StaticResource PrimaryDatePickerStyle}"/>

                <!-- Длительность (дни) -->
                <Label Content="Длительность (дней):" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <TextBox x:Name="DurationTextBox" 
                        Text="{Binding CurrentEvent.ДлительностьДней, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PrimaryTextBoxStyle}"/>

                <!-- Город -->
                <Label Content="Город:" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <ComboBox x:Name="CityComboBox"
                         DisplayMemberPath="Название"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding CurrentEvent.ГородId}"
                         Style="{StaticResource PrimaryComboBoxStyle}"/>

                <!-- Направление -->
                <Label Content="Направление:" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <ComboBox x:Name="DirectionComboBox"
                         DisplayMemberPath="Название"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding CurrentEvent.НаправлениеId}"
                         Style="{StaticResource PrimaryComboBoxStyle}"/>

                <!-- Изображение -->
                <Label Content="Изображение (опционально):" 
                       Style="{StaticResource PrimaryLabelStyle}"
                       Margin="0,10,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ImagePathTextBox"
                            Grid.Column="0"
                            Text="{Binding CurrentEvent.Фото, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource PrimaryTextBoxStyle}"
                            Margin="0,0,10,0"/>

                    <Button x:Name="BrowseImageButton"
                            Grid.Column="1"
                            Content="Обзор..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,5"
                            Click="BrowseImageButton_Click"/>
                </Grid>

                <!-- Предпросмотр изображения -->
                <Border x:Name="PreviewBorder"
                        Style="{StaticResource EventCardStyle}"
                        Height="150"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="15,8"
                    Click="SaveButton_Click"
                    IsDefault="True"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>