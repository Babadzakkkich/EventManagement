<Window x:Class="EventManagement.Dialogs.SelectActivitiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор активностей" 
        Height="500" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и информация -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Выбор активностей для участия" 
                      Style="{StaticResource SubHeaderTextStyle}"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Выберите активности, в которых хотите участвовать. Вы должны выбрать хотя бы одну активность."
                      Style="{StaticResource NormalTextStyle}"
                      TextWrapping="Wrap"
                      Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Список активностей -->
        <Border Style="{StaticResource EventCardStyle}" Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ActivitiesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EventCardStyle}" 
                                    Margin="0,0,0,10">
                                <CheckBox x:Name="ActivityCheckBox"
                                          Content="{Binding Название}"
                                          Style="{StaticResource PrimaryCheckBoxStyle}"
                                          Tag="{Binding Id}">
                                    <CheckBox.ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Название}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding День, StringFormat='День {0}'}"/>
                                            <TextBlock Text="{Binding ВремяНачала, StringFormat='Время: {0:hh\\:mm}'}"/>
                                            <TextBlock Text="Продолжительность: 90 мин"/>
                                        </StackPanel>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button x:Name="SelectAllButton"
                    Content="Выбрать все"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,5"
                    Click="SelectAllButton_Click"/>

            <Button x:Name="DeselectAllButton"
                    Content="Снять все"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    Click="DeselectAllButton_Click"/>

            <Button x:Name="OkButton"
                    Content="Подтвердить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="15,8"
                    Margin="20,0,0,0"
                    Click="OkButton_Click"
                    IsDefault="True"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>