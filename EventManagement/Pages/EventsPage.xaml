<Page x:Class="EventManagement.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мероприятия">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Страница мероприятий" 
                      Style="{StaticResource HeaderTextStyle}"/>
            <TextBlock Text="Здесь будет список мероприятий" 
                      Style="{StaticResource NormalTextStyle}"
                      Margin="0,20,0,0"/>

            <!-- Кнопка для перехода в профиль (будет скрыта в коде если пользователь не авторизован) -->
            <Button x:Name="ProfileButton"
                    Content="Перейти в профиль" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,30,0,0"
                    Click="ProfileButton_Click"/>
        </StackPanel>
    </Grid>
</Page>