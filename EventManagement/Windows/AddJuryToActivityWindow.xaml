<Window x:Class="EventManagement.Windows.AddJuryToActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление жюри к активности" 
        MinHeight="500" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Добавление жюри" 
                  Style="{StaticResource HeaderTextStyle}"
                  Grid.Row="0"/>

        <!-- Форма -->
        <StackPanel Grid.Row="1">
            <!-- Информация об активности -->
            <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Активность:"
                              Style="{StaticResource NormalTextStyle}"
                              FontWeight="Bold"/>
                    <TextBlock Text="{Binding Activity.Название}"
                              Style="{StaticResource NormalTextStyle}"
                              Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Activity.Мероприятия.Название, StringFormat='Мероприятие: {0}'}"
                              Style="{StaticResource NormalTextStyle}"
                              FontSize="12"
                              Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Список доступных жюри -->
            <Label Content="Доступные члены жюри:" 
                   Style="{StaticResource PrimaryLabelStyle}"/>
            <Border Style="{StaticResource EventCardStyle}" Height="250">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="JuryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding ФИО}"
                                         Tag="{Binding Id}"
                                         IsChecked="{Binding IsSelected}"
                                         Margin="5,2"
                                         Style="{StaticResource PrimaryCheckBoxStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,20,0,0">
            <Button x:Name="SaveButton"
                    Content="Добавить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="15,8"
                    Click="SaveButton_Click"
                    IsDefault="True"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>