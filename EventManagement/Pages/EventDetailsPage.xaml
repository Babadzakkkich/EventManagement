<Page x:Class="EventManagement.Pages.EventDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Детали мероприятия">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Заголовок и кнопки действий -->
                <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Заголовок мероприятия -->
                        <TextBlock Text="{Binding Название}" 
                                  Style="{StaticResource HeaderTextStyle}"
                                  Grid.Column="0"/>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal"
                                   x:Name="ActionButtonsPanel">
                            <Button x:Name="EditEventButton"
                                    Content="Редактировать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="EditEventButton_Click"
                                    Visibility="Collapsed"/>

                            <Button x:Name="JoinEventButton"
                                    Content="Участвовать"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="JoinEventButton_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Основная информация -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левый блок - изображение и детали -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <!-- Изображение мероприятия -->
                        <Border Style="{StaticResource EventCardStyle}"
                                Height="200"
                                Margin="0,0,0,15">
                            <Image x:Name="EventImage"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- Детали мероприятия -->
                        <Border Style="{StaticResource EventCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Детали мероприятия" 
                                          Style="{StaticResource SubHeaderTextStyle}"
                                          Margin="0,0,0,10"/>

                                <StackPanel>
                                    <TextBlock Text="{Binding ДатаНачала, StringFormat='Дата начала: {0:dd.MM.yyyy}'}"
                                              Style="{StaticResource NormalTextStyle}"/>

                                    <TextBlock Text="{Binding ДлительностьДней, StringFormat='Длительность: {0} дней'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>

                                    <TextBlock Text="{Binding Города.Название, StringFormat='Город: {0}'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>

                                    <TextBlock Text="{Binding Направления.Название, StringFormat='Направление: {0}'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>

                                    <TextBlock Text="{Binding Пользователи.ФИО, StringFormat='Организатор: {0}'}"
                                              Style="{StaticResource NormalTextStyle}"
                                              Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Правый блок - описание и активности -->
                    <StackPanel Grid.Column="1">
                        <!-- Описание -->
                        <Border Style="{StaticResource EventCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Описание" 
                                          Style="{StaticResource SubHeaderTextStyle}"
                                          Margin="0,0,0,10"/>

                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Описание}"
                                              Style="{StaticResource NormalTextStyle}"
                                              TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Активности -->
                        <Border Style="{StaticResource EventCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Активности" 
                                              Style="{StaticResource SubHeaderTextStyle}"
                                              Grid.Column="0"/>

                                    <Button x:Name="AddActivityButton"
                                            Grid.Column="1"
                                            Content="+ Добавить активность"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddActivityButton_Click"
                                            Visibility="Collapsed"/>
                                </Grid>

                                <!-- Список активностей -->
                                <ItemsControl x:Name="ActivitiesItemsControl" 
                                             Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EventCardStyle}" 
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Информация об активности -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Название}"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontWeight="Bold"/>

                                                        <StackPanel Orientation="Horizontal" 
                                                                   Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding День, StringFormat='День {0}'}"
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text=" • " 
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text="{Binding ВремяНачала, StringFormat='Время: {0:hh\\:mm}'}"
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text=" • " 
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>

                                                            <TextBlock Text="90 мин."
                                                                      Style="{StaticResource NormalTextStyle}"
                                                                      FontSize="12"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Пользователи.ФИО, StringFormat='Модератор: {0}'}"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontSize="12"
                                                                  Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <!-- Кнопка удаления активности (только для организатора) -->
                                                    <Button Grid.Column="1"
                                                            Content="✕"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="5"
                                                            Width="25"
                                                            Height="25"
                                                            Visibility="Collapsed"
                                                            Click="DeleteActivityButton_Click"
                                                            Tag="{Binding Id}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="NoActivitiesText"
                                          Text="Активности не добавлены"
                                          Style="{StaticResource HintTextStyle}"
                                          HorizontalAlignment="Center"
                                          Margin="0,10,0,0"
                                          Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>