<Page x:Class="EventManagement.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мероприятия"
      Loaded="Page_Loaded">

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтров -->
        <Border Grid.Row="0" 
                Style="{StaticResource EventCardStyle}"
                Margin="10"
                Padding="15">
            <StackPanel>
                <TextBlock Text="Поиск и фильтрация" 
                          Style="{StaticResource SubHeaderTextStyle}"
                          Margin="0,0,0,10"/>

                <!-- Строка поиска -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" 
                            Style="{StaticResource PrimaryTextBoxStyle}"
                            Margin="0,0,10,0"
                            TextChanged="SearchTextBox_TextChanged"
                            Padding="10">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <!-- Фильтры -->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <!-- Фильтр по направлению -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Направление:" 
                                  Style="{StaticResource NormalTextStyle}"
                                  Margin="0,0,0,5"/>
                        <ComboBox x:Name="DirectionComboBox"
                                 Style="{StaticResource PrimaryComboBoxStyle}"
                                 Width="200"
                                 SelectionChanged="DirectionComboBox_SelectionChanged"/>
                    </StackPanel>

                    <!-- Фильтр по дате -->
                    <StackPanel>
                        <TextBlock Text="Дата начала:" 
                                  Style="{StaticResource NormalTextStyle}"
                                  Margin="0,0,0,5"/>
                        <DatePicker x:Name="DateFilterPicker"
                                   Style="{StaticResource PrimaryDatePickerStyle}"
                                   Width="200"
                                   SelectedDateChanged="DateFilterPicker_SelectedDateChanged"/>
                    </StackPanel>

                    <!-- Кнопка сброса фильтров -->
                    <Button x:Name="ResetFiltersButton"
                            Content="Сбросить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="20,25,0,0"
                            Padding="10,5"
                            Click="ResetFiltersButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Панель действий для организатора -->
        <Border Grid.Row="1" 
                Style="{StaticResource EventCardStyle}"
                Margin="10,0,10,10"
                Padding="10"
                x:Name="OrganizerPanel"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddEventButton"
                        Content="+ Добавить мероприятие"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="15,8"
                        Click="AddEventButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Список мероприятий -->
        <ScrollViewer Grid.Row="2" 
                     VerticalScrollBarVisibility="Auto"
                     Margin="10">
            <ItemsControl x:Name="EventsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource EventCardStyle}"
                                Margin="0,0,0,15"
                                Cursor="Hand"
                                MouseDown="EventCard_MouseDown"
                                Tag="{Binding Id}">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок мероприятия -->
                                <TextBlock Grid.Row="0"
                                          Text="{Binding Название}"
                                          Style="{StaticResource HeaderTextStyle}"
                                          TextWrapping="Wrap"
                                          TextAlignment="Center"
                                          Margin="0,0,0,15"/>

                                <!-- Контент мероприятия -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левый блок с изображением и основной информацией -->
                                    <StackPanel Grid.Column="0" 
                                               Margin="0,0,20,0">
                                        <!-- Изображение мероприятия -->
                                        <Border Height="180" 
                                                Background="{StaticResource SecondaryBackgroundBrush}"
                                                CornerRadius="8"
                                                Margin="0,0,0,15">
                                            <Image x:Name="EventImage"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <!-- Основная информация -->
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="📅 "
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding ДатаНачала, StringFormat='dd.MM.yyyy'}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="📍 "
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding Города.Название}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="👤 "
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding Пользователи.ФИО}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🎯 "
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding Направления.Название}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⏱️ "
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                                <TextBlock Text="{Binding ДлительностьДней, StringFormat='{}{0} дней'}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Правый блок с описанием -->
                                    <Border Grid.Column="1" 
                                            Style="{StaticResource EventCardStyle}"
                                            Background="{StaticResource SecondaryBackgroundBrush}"
                                            Opacity="0.7">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                            Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="Описание мероприятия"
                                                           Style="{StaticResource SubHeaderTextStyle}"
                                                           Margin="0,0,0,10"/>

                                                <TextBlock Text="{Binding Описание}"
                                                          Style="{StaticResource NormalTextStyle}"
                                                          FontSize="14"
                                                          TextWrapping="Wrap"
                                                          LineHeight="20"
                                                          Margin="0,0,0,10"/>

                                                <!-- Блок с победителем -->
                                                <Border Style="{StaticResource EventCardStyle}"
                                                        Background="#E8F5E9"
                                                        Padding="10"
                                                        Visibility="{Binding ПобедительId, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <TextBlock Text="🏆 Победитель мероприятия:"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontWeight="Bold"
                                                                  Foreground="#2E7D32"/>
                                                        <TextBlock Text="{Binding Пользователи1.ФИО}"
                                                                  Style="{StaticResource NormalTextStyle}"
                                                                  FontSize="13"
                                                                  Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>